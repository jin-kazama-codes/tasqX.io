generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Project {
  key             String    
  name            String
  defaultAssignee String?
  imageUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
  deletedAt       DateTime?
  id              Int       @id @default(autoincrement())
  cloneChild      Boolean?  @default(false)
  showAssignedTasks      Boolean?  @default(false)
  workingDays     Int?      @default(5)
  companyId       Int?
  members         Member[]
}

model Company {
  id               Int   @id @default(autoincrement()) 
  name             String
  website          String?  
  email            String
  phone            String
  alternateNumber  String?  
  billingAddress   String
  gst              String
  subscriptionType String
  trialDuration    String?  
  date             String
  status           String
  logo              String? 
  bio             String? 
  proMember       Boolean?  @default(false)
  users            DefaultUser[] 
}

model Member {
  id        Int     @id
  projectId Int
  manager   Boolean?  @default(false)
  project   Project @relation(fields: [projectId], references: [id])
}

model Worklog {
  issueId         String
  timeLogged      String
  userName        String?
  createdAt       DateTime @default(now())
  workDescription String?
  id              String   @id @default(uuid())
}

model Document {
  id         Int      @id @default(autoincrement())
  projectId  Int
  name       String
  link       String?
  extensions String?
  ownerId    Int
  createdAt  DateTime @default(now())
  parentId   Int?
  type       String

  DefaultUser DefaultUser @relation(fields: [ownerId], references: [id])
  
  @@index([ownerId])
}

model Issue {
  id             String      @id @default(uuid())
  key            String
  name           String
  description    String?
  status         String?     
  type           IssueType   @default(TASK)
  sprintPosition Float
  boardPosition  Float       @default(-1)
  parentId       String?
  sprintId       String?
  isDeleted      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  sprintColor    String?
  reporterId     Int?
  assigneeId     Int?
  creatorId      Int?
  projectId      Int?
  comments       Comment[]
  estimateTime   String?
  timeSpent      String?
  storyPoints    Int?
  cost           Float?
  budget         Float?
  budgetTrack    String?
  priority       String?
  month          Int?
  acceptanceCriteria String?
  Sprint         Sprint?     @relation(fields: [sprintId], references: [id])

  @@index([sprintId])
}

model Sprint {
  id           String       @id @default(uuid())
  name         String
  description  String
  duration     String?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime?    @updatedAt
  deletedAt    DateTime?
  status       SprintStatus @default(PENDING)
  projectId    Int?
  creatorId    Int?
  position     Int?
  estimateTime String?
  timeTaken    String?
  issues       Issue[]
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isEdited  Boolean   @default(false)
  issueId   String
  logId     String?
  authorId  Int?
  imageURL  String?
  Issue     Issue?    @relation(fields: [issueId], references: [id])

  @@index([issueId])
}

model DefaultUser {
  name      String
  email     String     @unique(map: "unique_email")
  avatar    String?
  password  String?    @default("member@f2-fin")
  role      role?      @default(member)
  status    Boolean    @default(false)
  id        Int        @id @default(autoincrement())
  documents Document[]
  companyId Int
  Company   Company? @relation(fields: [companyId], references: [id])
  
  @@index([companyId])
}

model Account {
  id      Int     @id @default(autoincrement())
  name    String?
  logo    String?
  contact Int?
  email   String?
  bio     String?
  url     String?
}

model Workflow {
  projectId       Int       @id
  workflow        Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
}

enum IssueType {
  BUG
  TASK
  SUBTASK
  STORY
  EPIC
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum SprintStatus {
  ACTIVE
  PENDING
  CLOSED
}

enum Duration {
  ONE_WEEK
  TWO_WEEKS
  THREE_WEEKS
  FOUR_WEEKS
  CUSTOM
}

enum role {
  admin
  manager
  member
  superAdmin
}
